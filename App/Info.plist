	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ji</string>
				<string>journalinsight</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
